<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NdevTools | Tab Hider"
 Width="720" Height="610" MinHeight="350" MinWidth="450" WindowStartupLocation="CenterOwner"
 Background="#051220" Foreground="#DEEFFB" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DEEFFB"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4,0"/></Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12">
   <DockPanel>
    <Button x:Name="help_button" DockPanel.Dock="Right" Content="? Help"
            ToolTip="How to show, hide, and save ribbon choices" VerticalAlignment="Center"/>
    <Button x:Name="linkedin_button" DockPanel.Dock="Right" Content="LinkedIn"
            Tag="https://www.linkedin.com/in/nataraj016/" ToolTip="Nataraj Devaraj on LinkedIn"
            VerticalAlignment="Center"/>
    <Button x:Name="github_button" DockPanel.Dock="Right" Content="★ GitHub"
            Tag="https://github.com/ndev16/NdevTools" ToolTip="Star NdevTools on GitHub"
            VerticalAlignment="Center"/>
    <TextBlock Text="Tab Hider" Foreground="#00C5E3" FontSize="24" FontWeight="Bold"/>
   </DockPanel>
   <TextBlock Text="Checked = visible. Uncheck a tab or panel, then click Apply." Margin="0,8,0,4" TextWrapping="Wrap"/>
   <TextBlock Text="Apply and Show All save your choices for future Revit sessions. Revit controls contextual and protected tabs." FontSize="11" Foreground="#88ADC2" TextWrapping="Wrap"/>
  </StackPanel>
  <TabControl x:Name="visibility_pages" Grid.Row="1" Background="#051220" BorderBrush="#245064" SelectedIndex="0">
   <TabItem Header="All Revit Tabs">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="tab_list" Margin="8"/></ScrollViewer>
   </TabItem>
  </TabControl>
  <TextBlock Grid.Row="2" x:Name="status" TextWrapping="Wrap" Margin="0,10" Foreground="#88ADC2"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="show_all_button" Content="Show All"/>
   <Button x:Name="apply_button" Content="Apply"/>
   <Button x:Name="close_button" Content="Close" IsCancel="True"/>
  </StackPanel>
 </Grid>
</Window>
