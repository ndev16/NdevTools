<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NdevTools | Choose Properties"
 Width="560" Height="620" MinWidth="480" MinHeight="420" Background="#051220"
 Foreground="#DEEFFB" FontFamily="Segoe UI" WindowStartupLocation="CenterOwner">
 <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DEEFFB"/>
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0BE7FC"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#88ADC2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="BorderBrush" Value="#075776"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#052039" Offset="0"/>
                        <GradientStop Color="#061B2F" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#09243A"/>
            <Setter Property="Foreground" Value="#D5EDFA"/>
            <Setter Property="BorderBrush" Value="#176282"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#124264"/>
                                <Setter Property="BorderBrush" Value="#02D8F5"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0FE0FB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0A354B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0DC7E7"/>
            <Setter Property="Foreground" Value="#002032"/>
            <Setter Property="BorderBrush" Value="#0FE0FB"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#6DEFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DEEFFB"/><Setter Property="Margin" Value="4,6"/></Style>
 </Window.Resources>
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border BorderBrush="#165573" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12"><StackPanel>
   <TextBlock Text="Match Properties" Foreground="#06D8FB" FontSize="21" FontWeight="Bold"/>
   <TextBlock x:Name="source_label" Margin="0,6,0,0" TextWrapping="Wrap"/>
   <TextBlock Text="Checked fields copy to similar elements. Uncheck anything you want to keep." Margin="0,6,0,0" TextWrapping="Wrap"/>
  </StackPanel></Border>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
   <Button x:Name="all_button" Content="Select all"/><Button x:Name="none_button" Content="Check None" ToolTip="Uncheck every property, including Element Type."/>
   <Button x:Name="levels_button" Content="Exclude Levels"/>
  </StackPanel>
  <Border Grid.Row="2" Style="{StaticResource PanelCard}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="CHOOSE PROPERTIES TO COPY" Style="{StaticResource SectionHeading}"/><StackPanel x:Name="property_rows"/></StackPanel></ScrollViewer></Border>
  <TextBlock Grid.Row="3" x:Name="notes" Foreground="#88ADC2" TextWrapping="Wrap" Margin="0,10"/>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="continue_button" Content="Select target elements" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
   <Button x:Name="cancel_button" Content="Cancel" IsCancel="True"/>
  </StackPanel>
 </Grid>
</Window>
