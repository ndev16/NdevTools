<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NdevTools | Move Views - Help" Width="550" Height="470"
        MinWidth="320" MinHeight="250" WindowStartupLocation="CenterOwner"
        Background="#051220" Foreground="#DEEFFB" FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False" UseLayoutRounding="True">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="heading" Foreground="#06D8FB" FontWeight="Bold" FontSize="16"
               TextWrapping="Wrap" Margin="0,0,0,12"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <TextBlock x:Name="instructions" Foreground="#DEEFFB" TextWrapping="Wrap" LineHeight="19" Margin="0,0,8,4"/>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
      <Button x:Name="github" Content="★ GitHub" MinWidth="82" ToolTip="Open the NdevTools GitHub repository" AutomationProperties.Name="Star NdevTools on GitHub"/>
      <Button x:Name="linkedin" Content="LinkedIn" Tag="https://www.linkedin.com/in/nataraj016/" MinWidth="82"/>
      <Button Content="Close" IsCancel="True" MinWidth="72"/>
    </WrapPanel>
  </Grid>
</Window>
