<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" Height="340" MinWidth="360" MinHeight="290"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#051220" Foreground="#DEEFFB" FontFamily="Segoe UI" FontSize="13">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <TextBlock Text="NdevTools" FontWeight="Bold" FontSize="11" Foreground="#06D8FB"/>
      <TextBlock x:Name="HelpHeading" FontWeight="Bold" FontSize="21" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <WrapPanel>
        <Button x:Name="GitHubButton" Content="GitHub" Tag="https://github.com/ndev16/NdevTools" Margin="0,0,6,0"/>
        <Button x:Name="LinkedInButton" Content="LinkedIn" Tag="https://www.linkedin.com/in/nataraj016/"/>
      </WrapPanel>
      <TextBlock x:Name="HelpCredit" Foreground="#88ADC2" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Background="#09243A" BorderBrush="#165573" BorderThickness="1" CornerRadius="6" Padding="12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="1" Foreground="#06D8FB" FontWeight="Bold" Margin="0,0,10,0"/>
          <TextBlock Grid.Column="1" x:Name="SelectStep" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="1" Text="2" Foreground="#06D8FB" FontWeight="Bold" Margin="0,10,10,0"/>
          <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PasteStep" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </Grid>
      </Border>
    </ScrollViewer>
  </DockPanel>
</Window>
