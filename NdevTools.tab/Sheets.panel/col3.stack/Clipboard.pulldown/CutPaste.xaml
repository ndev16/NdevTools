<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Width="650" Height="590" MinWidth="500" MinHeight="460" WindowStartupLocation="CenterOwner"
        Background="#051220" Foreground="#DEEFFB" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="61" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#09243A"/><Setter Property="Foreground" Value="#DEEFFB"/>
      <Setter Property="BorderBrush" Value="#21536A"/><Setter Property="Padding" Value="13,6"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#05D5EC"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".44"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="#002032"/><Setter Property="Background" Value="#0DC7E7"/>
      <Setter Property="BorderBrush" Value="#0FE0FB"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#DEEFFB"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Padding="9,6"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#124264"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#116175"/><Setter Property="Foreground" Value="White"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#165573" BorderThickness="1">
  <DockPanel Margin="16,0,16,12">
    <Border DockPanel.Dock="Top" MinHeight="62" Padding="0,8" BorderBrush="#165573" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="HelpButton" Content="?" Width="30" MinHeight="28" Padding="0" Margin="8,0,4,0"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="CloseButton" Content="×" Width="30" MinHeight="28" Padding="0" IsCancel="True"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
        <Image x:Name="BrandLogo" DockPanel.Dock="Left" Width="36" Height="38" Stretch="Uniform"/>
        <Border DockPanel.Dock="Left" Width="1" Height="34" Background="#176A8B" Margin="8,0,10,0"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="NdevTools" Foreground="#06D8FB" FontSize="11" FontWeight="Bold"/>
          <TextBlock x:Name="Heading" FontSize="21" FontWeight="Bold" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <TextBlock x:Name="SheetName" DockPanel.Dock="Top" Margin="0,9,0,10" Foreground="#ABD5E8" TextWrapping="Wrap"/>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <Border Background="#09243A" BorderBrush="#21536A" BorderThickness="1" CornerRadius="4" Padding="12,9">
        <TextBlock x:Name="Hint" Foreground="#AED1DF" TextWrapping="Wrap"/>
      </Border>
      <DockPanel Margin="0,10,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="DismissButton" Margin="0,0,6,0" IsCancel="True"/>
          <Button x:Name="ChooseButton" Style="{StaticResource Primary}"/>
        </StackPanel>
        <TextBlock x:Name="Credit" Margin="0,0,6,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11" Foreground="#88ADC2"/>
      </DockPanel>
    </StackPanel>
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
        <Button x:Name="SelectAllButton" DockPanel.Dock="Right"/>
        <TextBlock x:Name="Count" VerticalAlignment="Center" Foreground="#AED1DF"/>
      </DockPanel>
      <ListBox x:Name="Placements" SelectionMode="Multiple" Background="#092940" Foreground="#DEEFFB"
               BorderBrush="#21536A" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
    </DockPanel>
  </DockPanel>
  </Border>
</Window>
