
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trace Elements - Filled Region Assignments" Width="1180" Height="620"
        MinWidth="820" MinHeight="420" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize" Background="#FFFFFF">
  <!-- Custom caption: Help lives BESIDE minimize / maximize / close. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="38"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border x:Name="title_bar" Grid.Row="0" Background="#EAF0F6"
            BorderBrush="#D4DEE8" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="title_caption" Grid.Column="0"
                   Text="Ndev Tools - Auto Detail Generator - Trace Settings"
                   VerticalAlignment="Center" Margin="14,0,0,0"
                   FontSize="13" Foreground="#172A3A"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
          <Button x:Name="title_help_button" Content="? Help"
                  Width="78" Margin="0,4,8,4" Padding="8,0"
                  ToolTip="Ndev Tools help, GitHub and LinkedIn"/>
          <Button x:Name="title_minimize_button" Content="&#x2013;"
                  Width="44" Background="Transparent" BorderThickness="0"
                  ToolTip="Minimize"/>
          <Button x:Name="title_maximize_button" Content="&#x25A1;"
                  Width="44" Background="Transparent" BorderThickness="0"
                  ToolTip="Maximize"/>
          <Button x:Name="title_close_button" Content="&#x2715;"
                  Width="46" Background="Transparent" BorderThickness="0"
                  ToolTip="Close"/>
        </StackPanel>
      </Grid>
    </Border>

  <!-- The existing settings, five tabs and Create Details controls are unchanged. -->
  <Grid Grid.Row="1" Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Choose fills, outlines, and detail components" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Margin="0,8,0,16" TextWrapping="Wrap"
      Text="Type directly in any dropdown to see matching suggestions immediately. Click a match or press Enter to select; Escape restores the previous selection. Each row applies to that component type. A line style with no fill creates detail lines; with a fill it styles the region boundary. CMU repeats use an existing placed repeating detail as a template. In sections choose Horizontal or Vertical; plans follow wall length. Roof line-based details follow top slopes in sections and top-face edges in plans. Floor line-based details run horizontally along the traced floor, split at openings. Framing details align their bounding-box center with the traced framing center."/>
    <TabControl Grid.Row="2">
      <TabItem Header="Walls"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel x:Name="walls_panel" Margin="12"/></ScrollViewer></TabItem>
      <TabItem Header="Floors"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel x:Name="floors_panel" Margin="12"/></ScrollViewer></TabItem>
      <TabItem Header="Roofs"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel x:Name="roofs_panel" Margin="12"/></ScrollViewer></TabItem>
      <TabItem Header="Structural Foundations"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel x:Name="foundations_panel" Margin="12"/></ScrollViewer></TabItem>
      <TabItem Header="Structural Framing"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel x:Name="framing_panel" Margin="12"/></ScrollViewer></TabItem>
    </TabControl>
    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="All choices empty = skip type. CMU paths stop at openings and crop limits."/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="Cancel" Width="90" Height="32" Margin="0,0,10,0" IsCancel="True"/>
        <Button x:Name="create_button" Content="Create Details" Width="130" Height="32" IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Grid>
  </Grid>
</Window>
