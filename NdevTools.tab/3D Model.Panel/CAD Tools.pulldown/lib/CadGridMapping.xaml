<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NdevTools | CAD to Grids Mapping" Width="1080" Height="710" MinWidth="740" MinHeight="490"
 WindowStartupLocation="CenterScreen" Background="#051522" Foreground="#E9F6FF" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
    <SolidColorBrush x:Key="Cyan" Color="#00C6E8"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9F6FF"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#092536"/><Setter Property="Foreground" Value="#00D9F4"/>
      <Setter Property="BorderBrush" Value="#00BBDC"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,7"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chrome" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="chrome" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0B2536"/><Setter Property="Foreground" Value="#E9F6FF"/><Setter Property="CaretBrush" Value="#00D9F4"/><Setter Property="BorderBrush" Value="#285269"/><Setter Property="Padding" Value="8,5"/></Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E9F6FF"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Margin" Value="6,4"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid Width="14" Height="14" VerticalAlignment="Center">
            <Border x:Name="checkBorder" Background="#0B2536" BorderBrush="#41677B" BorderThickness="1" CornerRadius="3"/>
            <Path x:Name="checkGlyph" Data="M 3,7 L 6,10 L 11,4" Stroke="#031A28" StrokeThickness="1.8" Visibility="Collapsed"/>
          </Grid>
          <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="checkBorder" Property="Background" Value="#00C6E8"/><Setter TargetName="checkBorder" Property="BorderBrush" Value="#00C6E8"/><Setter TargetName="checkGlyph" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="checkBorder" Property="BorderBrush" Value="#8CE8F5"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E9F6FF"/><Setter Property="Background" Value="#0B2536"/><Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#175570"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#14536A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E9F6FF"/><Setter Property="Background" Value="#0B2536"/>
      <Setter Property="BorderBrush" Value="#285269"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="MaxDropDownHeight" Value="300"/><Setter Property="IsTextSearchEnabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#0B2536" BorderBrush="#285269" BorderThickness="1" CornerRadius="3"><TextBlock Text="âŒ„" Foreground="#00D9F4" HorizontalAlignment="Right" Margin="0,0,10,0"/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="9,4,30,4" IsHitTestVisible="False" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
            <Border Background="#0B2536" BorderBrush="#00A6C6" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <ScrollViewer MaxHeight="300" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#071E2D"/><Setter Property="BorderBrush" Value="#19465B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="14"/></Style>
 </Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,12"><Button Content="? Help" DockPanel.Dock="Right" Click="help_click" VerticalAlignment="Center"/><Button Content="&#9733; Star NdevTools on GitHub" DockPanel.Dock="Right" Click="github_click" Margin="0,0,8,0" VerticalAlignment="Center"/>
   <Image x:Name="logo" Width="58" Height="58" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="CAD GRID MAPPING" Foreground="#00C6E8" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Review the actual CAD names and edit the proposed Revit names." Foreground="#8DB6CC"/></StackPanel></DockPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,10"><TextBlock Text="CAD drawing" Margin="0,0,12,0"/><Button DockPanel.Dock="Right" Content="Source DWG…" Click="browse_click" Margin="8,0,0,0" ToolTip="Read grid bubble labels from the original drawing"/><ComboBox x:Name="drawing" SelectionChanged="drawing_changed"/></DockPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1.55*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Margin="0,0,8,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="GRID LAYERS" Foreground="#00C6E8" FontWeight="SemiBold" Margin="0,0,0,8"/><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="layer_rows"/></ScrollViewer></DockPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="HORIZONTAL GRIDS" Foreground="#00C6E8" FontWeight="SemiBold"/><TextBlock Text="Bottom to top" Margin="0,4,0,8"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="horizontal_rows"/></ScrollViewer></DockPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="VERTICAL GRIDS" Foreground="#00C6E8" FontWeight="SemiBold"/><TextBlock Text="Left to right" Margin="0,4,0,8"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="vertical_rows"/></ScrollViewer></DockPanel></Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="0,12,0,0"><Button x:Name="create_button" DockPanel.Dock="Right" Content="Create grids" Click="create_click"/><Button DockPanel.Dock="Right" Content="Cancel" Click="cancel_click" Margin="0,0,8,0"/>
   <StackPanel><TextBlock x:Name="status" TextWrapping="Wrap" Foreground="#8DB6CC"/><TextBlock Text="Created by Nataraj Devaraj" Foreground="#8DB6CC" Margin="0,4,0,0"/></StackPanel>
  </DockPanel>
 </Grid>
</Window>