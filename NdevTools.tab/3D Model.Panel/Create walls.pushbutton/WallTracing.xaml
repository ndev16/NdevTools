<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NdevTools | Wall Tracing" Width="1080" Height="820" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#051522" Foreground="#E9F6FF"
        FontFamily="Segoe UI" FontSize="14" ResizeMode="CanResizeWithGrip">
  <Window.Resources>
    <SolidColorBrush x:Key="Cyan" Color="#00C6E8"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9F6FF"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#092536"/><Setter Property="Foreground" Value="#00D9F4"/>
      <Setter Property="BorderBrush" Value="#00BBDC"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="chrome" Property="Opacity" Value="0.8"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="chrome" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#0B2536"/><Setter Property="Foreground" Value="#E9F6FF"/><Setter Property="CaretBrush" Value="#00D9F4"/><Setter Property="BorderBrush" Value="#285269"/><Setter Property="Padding" Value="10,8"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E9F6FF"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="8"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#E9F6FF"/><Setter Property="Background" Value="#0B2536"/><Setter Property="Padding" Value="8"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="itemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#175570"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="itemBorder" Property="Background" Value="#14536A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E9F6FF"/><Setter Property="Background" Value="#0B2536"/>
      <Setter Property="BorderBrush" Value="#285269"/><Setter Property="MinHeight" Value="36"/>
      <Setter Property="MaxDropDownHeight" Value="300"/><Setter Property="IsTextSearchEnabled" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#0B2536" BorderBrush="#285269" BorderThickness="1" CornerRadius="3"><TextBlock Text="⌄" Foreground="#00D9F4" HorizontalAlignment="Right" Margin="0,0,10,0"/></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter Margin="9,4,30,4" IsHitTestVisible="False" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
            <Border Background="#0B2536" BorderBrush="#00A6C6" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <ScrollViewer MaxHeight="300" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#071E2D"/><Setter Property="BorderBrush" Value="#19465B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="18"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
      <Image x:Name="brand_logo" Width="68" Height="68" Stretch="Uniform"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,20,0"><TextBlock FontSize="27" FontWeight="SemiBold"><Run Text="Ndev"/><Run Text="Tools" Foreground="#00C6E8"/></TextBlock><TextBlock Text="SMART BIM TOOLS" FontSize="11" Margin="2,6,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="Wall Tracing" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Trace walls from linked architectural model" Foreground="#A6C6D9" Margin="0,5,0,0"/></StackPanel>
      <Button Grid.Column="3" x:Name="help_button" Content="?  Help" VerticalAlignment="Center" Padding="10"/>
    </Grid>
    <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border x:Name="step_one" Background="#00C6E8" CornerRadius="5,0,0,5"><TextBlock x:Name="step_one_text" Text="1   Select Link &amp; Levels" Foreground="#031A28" HorizontalAlignment="Center" FontSize="16"/></Border>
      <Border Grid.Column="1" x:Name="step_two" Background="#0B2A3D" CornerRadius="0,5,5,0"><TextBlock x:Name="step_two_text" Text="2   Wall Mapping &amp; Options" Foreground="#8DB6CC" HorizontalAlignment="Center" FontSize="16"/></Border>
    </Grid>
    <Grid Grid.Row="2" x:Name="page_one" Margin="0,8,0,8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="1   Select Architectural Link" FontSize="19" Margin="0,0,0,12"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><ComboBox x:Name="link_combo"/><Button Grid.Column="1" x:Name="pick_button" Content="Pick Link" Margin="12,0,0,0"/></Grid>
        <TextBlock x:Name="link_info" Text="Choose a loaded architectural Revit link." Foreground="#A6C6D9" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel></Border>
      <Border Grid.Row="1" Style="{StaticResource Card}"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="2   Select Levels from Linked Model" FontSize="19" Margin="0,0,0,12"/>
        <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="125"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
          <Grid><TextBox x:Name="search_box" ToolTip="Search levels"/>
            <TextBlock Text="Search levels..." IsHitTestVisible="False" Margin="11,0,0,0" Foreground="#8DB6CC">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="VerticalAlignment" Value="Center"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=search_box}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
          <Button Grid.Column="1" x:Name="select_all_button" Content="Select All" Margin="10,0,0,0"/><Button Grid.Column="2" x:Name="deselect_all_button" Content="Deselect All" Margin="10,0,0,0"/>
        </Grid>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="level_rows"/></ScrollViewer>
        <TextBlock Grid.Row="3" x:Name="selection_count" Text="0 levels selected" Foreground="#74BED8" Margin="0,8,0,0"/>
      </Grid></Border>
    </Grid>
    <Grid Grid.Row="2" x:Name="page_two" Visibility="Collapsed" Margin="0,8,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="Host types are suggested by structural-layer thickness. Review every type; amber notes flag a nearest-width match.&#10;Width alone does not establish material or structural equivalence. Choose None to skip a source type.&#10;Existing matching walls are skipped; this tool creates walls only and does not create or change openings." TextWrapping="Wrap" Foreground="#A6C6D9"/>
      </StackPanel></Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel x:Name="mapping_panels" MinWidth="810"/></ScrollViewer>
    </Grid>
    <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="140"/><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
      <Button x:Name="cancel_button" Content="Cancel" IsCancel="True"/>
      <Button Grid.Column="1" x:Name="back_button" Content="←  Back" Margin="10,0,0,0" Visibility="Collapsed"/>
      <Button Grid.Column="3" x:Name="next_button" Content="Next  →" Background="#00C6E8" Foreground="#031A28" FontSize="18" FontWeight="SemiBold"/>
    </Grid>
  </Grid>
</Window>
