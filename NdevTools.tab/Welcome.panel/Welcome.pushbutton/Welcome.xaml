<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ndev Tools - Welcome &amp; About"
        Width="1160" Height="690"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="Transparent" AllowsTransparency="True"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Cyan" Color="#00DAF2" />
        <SolidColorBrush x:Key="SoftText" Color="#B6D4E8" />
        <LinearGradientBrush x:Key="CanvasBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#04101F" Offset="0"/>
            <GradientStop Color="#072943" Offset="0.55"/>
            <GradientStop Color="#041626" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B3350" Offset="0"/>
            <GradientStop Color="#071B31" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ThankYouBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#342467" Offset="0"/>
            <GradientStop Color="#0B2D48" Offset="0.28"/>
            <GradientStop Color="#061C31" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E9F9FF" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Background" Value="#08304C" />
            <Setter Property="BorderBrush" Value="#008DBD" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outline" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="BorderBrush" Value="#00E9F9" />
                                <Setter TargetName="Outline" Property="Background" Value="#115071" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Outline" Property="Background" Value="#0B213A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TinyCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#75DCEA" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Light" />
        </Style>
    </Window.Resources>

    <!-- True rounded transparent WPF shell.  The shadow is drawn by an
         independent border, so it does NOT shadow the live text/buttons. -->
    <Grid Margin="13">
        <Border CornerRadius="24" Background="#062038" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="#00BDF3" ShadowDepth="0" BlurRadius="18" Opacity="0.67" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="24" BorderBrush="#00BADF" BorderThickness="1.6"
                Background="{StaticResource CanvasBrush}">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                <Grid Width="1120" Height="650">
                    <!-- Borders do not automatically clip children to rounded
                         corners.  This clip prevents squared-off titlebar edges. -->
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,1120,650" RadiusX="22" RadiusY="22" />
                    </Grid.Clip>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="205" />
                    <RowDefinition Height="171" />
                    <RowDefinition Height="111" />
                    <RowDefinition Height="111" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="345" />
                    <ColumnDefinition Width="775" />
                </Grid.ColumnDefinitions>

                <!-- Custom header. Drag to move; click X or Esc to close. -->
                <Border x:Name="TitleBar" Grid.Row="0" Grid.ColumnSpan="2"
                        Background="#0E2438" BorderBrush="#163B51" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="True" Margin="19,0,14,0">
                        <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="×" Width="38"
                                VerticalAlignment="Center" Height="40" ToolTip="Close"
                                Style="{StaticResource TinyCloseButton}" />
                        <TextBlock Text="Ndev Tools - About" VerticalAlignment="Center"
                                   FontSize="17" FontWeight="SemiBold" Foreground="#EDF9FD" />
                    </DockPanel>
                </Border>

                <!-- The architectual image, blended cyan wave and the upper-right
                     neon streak are decorative PNG layers drawn from the user's
                     APPROVED reference.  This image has transparency so it
                     merges smoothly into the navy canvas.  Controls remain live. -->
                <Image x:Name="AtmosphereImage" Grid.Row="0" Grid.RowSpan="5"
                       Grid.Column="0" Grid.ColumnSpan="2"
                       Stretch="Fill" IsHitTestVisible="False" />

                <!-- Original NdevTools logo. Its file is included UNMODIFIED. -->
                <StackPanel Grid.Column="0" Grid.Row="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="0,0,0,4">
                    <Image x:Name="NdevLogoImage" Width="154" Height="154"
                           Stretch="Uniform" ToolTip="Original NdevTools logo" />
                </StackPanel>

                <!-- Welcome -->
                <StackPanel Grid.Column="1" Grid.Row="1" Margin="10,14,20,0">
                    <TextBlock FontWeight="Bold" FontSize="57" Margin="0,-8,0,-2">
                        <Run Text="Ndev" Foreground="#F4FBFF"/><Run Text=" Tools" Foreground="#00D8F4"/>
                    </TextBlock>
                    <TextBlock Foreground="#D8E8F3" FontSize="19" TextWrapping="Wrap"
                               Margin="3,1,10,0" LineHeight="27">
                        A collection of useful tools to make your Revit Structure and BIM workflow simpler, faster and more enjoyable. Created by Nataraj Devaraj.
                    </TextBlock>
                    <TextBlock Text="Hope you're having a great day!  ☺"
                               Foreground="{StaticResource Cyan}" FontWeight="SemiBold"
                               FontSize="21" Margin="3,11,0,0" />
                </StackPanel>

                <!-- Compatibility; descriptive design range, not unverified testing claims. -->
                <Border Grid.Column="1" Grid.Row="2" Margin="3,3,19,8"
                        BorderBrush="#009CC8" BorderThickness="1.4"
                        CornerRadius="13" Background="{StaticResource CardBrush}">
                    <StackPanel Margin="23,12,17,9">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                            <TextBlock Text="⚙" FontSize="27" Foreground="#B7F6FF" VerticalAlignment="Center" />
                            <TextBlock Text="  Compatibility" FontSize="24" FontWeight="Bold"
                                       Foreground="#F5FBFF" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="229"/>
                                <ColumnDefinition Width="233"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="7,0,8,0">
                                <TextBlock Text="REVIT" FontSize="13" FontWeight="Bold" Foreground="#F7FBFF" />
                                <TextBlock Text="Designed for" FontSize="14" Foreground="{StaticResource SoftText}" Margin="0,8,0,0" />
                                <TextBlock Text="2022 to 2027" FontSize="23" Foreground="{StaticResource Cyan}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="#1A85A5">
                                <StackPanel Margin="17,0,10,0">
                                    <TextBlock Text="IRONPYTHON" FontSize="13" FontWeight="Bold" Foreground="#F7FBFF" />
                                    <TextBlock Text="Scripting engine" FontSize="14" Foreground="{StaticResource SoftText}" Margin="0,8,0,0" />
                                    <TextBlock x:Name="IronPythonVersionText" Text="IronPython 2.7"
                                               FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="#1A85A5">
                                <StackPanel Margin="17,0,0,0">
                                    <TextBlock Text="PYREVIT" FontSize="13" FontWeight="Bold" Foreground="#F7FBFF" />
                                    <TextBlock Text="Installed version" FontSize="14" Foreground="{StaticResource SoftText}" Margin="0,8,0,0" />
                                    <TextBlock x:Name="PyRevitVersionText" Text="Detecting…" FontSize="19"
                                               FontWeight="SemiBold" Foreground="{StaticResource Cyan}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Thank you message -->
                <Border Grid.Column="1" Grid.Row="3" Margin="3,3,19,8"
                        Background="{StaticResource ThankYouBrush}" BorderBrush="#7165D1"
                        BorderThickness="1.4" CornerRadius="13">
                    <Grid Margin="25,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="♥" Foreground="#FF5F9D"
                                   FontSize="60" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                            <TextBlock Text="Thank you for using Ndev Tools!" FontSize="22"
                                       FontWeight="Bold" Foreground="#F8FBFF" />
                            <TextBlock Text="Keep creating, keep exploring, and keep building amazing things in Revit!"
                                       FontSize="16" TextWrapping="Wrap" Foreground="#C8E0F2" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Functional GitHub, LinkedIn, email buttons. -->
                <Grid Grid.Column="1" Grid.Row="4" Margin="3,9,19,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="GitHubButton" Grid.Column="0" Height="66" Margin="0,2,10,6"
                            ToolTip="Open Ndev Tools GitHub" Style="{StaticResource ActionButton}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="GitHub" Foreground="#00E3FC" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="  ↗" Foreground="#CFECFA" FontSize="18"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LinkedInButton" Grid.Column="1" Height="66" Margin="0,2,10,6"
                            ToolTip="Connect on LinkedIn" Style="{StaticResource ActionButton}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="LinkedIn" Foreground="#00E3FC" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="  ↗" Foreground="#CFECFA" FontSize="18"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="EmailButton" Grid.Column="2" Height="66" Margin="0,2,0,6"
                            ToolTip="Compose an email to devnataraj39@gmail.com"
                            Style="{StaticResource ActionButton}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Have suggestions or feedback?" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#E1F5FD" HorizontalAlignment="Center"/>
                            <TextBlock Text="devnataraj39@gmail.com" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource Cyan}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                </Grid>
            </Viewbox>
        </Border>
    </Grid>
</Window>
