<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NdevTools | Useful Links" Width="1260" Height="880" MinWidth="900" MinHeight="580"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="54"/><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="28"/><RowDefinition Height="Auto"/><RowDefinition Height="52"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image x:Name="brand_logo" Width="48" Height="48" Stretch="Uniform"/>
      <Border Width="1" Height="44" Background="#176282" HorizontalAlignment="Right" Margin="0,0,1,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
        <TextBlock FontSize="26" FontWeight="Bold"><Run Text="Useful" Foreground="#E9F6FF"/><Run Text=" Links" Foreground="#00C6E8"/></TextBlock>
        <TextBlock Text="EVERYDAY WEB TOOLS" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
      </StackPanel>
      <Button Grid.Column="2" x:Name="help_button" Content="?  Help" MinWidth="82" Padding="12,7" VerticalAlignment="Center" ToolTip="Useful Links instructions and developer links"/>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,10">
      <Button x:Name="image_button" Content="Image to Text" MinWidth="160" Margin="0,0,10,0" ToolTip="Extract text from an image at imagetotext.info"/>
      <Button x:Name="case_button" Content="Convert Case" MinWidth="160" ToolTip="Change text capitalization at convertcase.net"/>
      <TextBlock Text="Switch tools without closing either page" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="20,0,0,0"/>
    </StackPanel>
    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="back_button" Content="Back" IsEnabled="False" Margin="0,0,6,0"/>
      <Button Grid.Column="1" x:Name="forward_button" Content="Forward" IsEnabled="False" Margin="0,0,6,0"/>
      <Button Grid.Column="2" x:Name="reload_button" Content="Reload" Margin="0,0,10,0"/>
      <TextBox Grid.Column="3" x:Name="address_box" IsReadOnly="True" VerticalContentAlignment="Center" FontSize="12" ToolTip="Current page address"/>
      <Button Grid.Column="4" x:Name="external_button" Content="Open in browser" Margin="10,0,0,0"/>
    </Grid>
    <Border Grid.Row="3" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
      <Grid>
        <Grid x:Name="browser_host"/>
        <StackPanel x:Name="fallback_panel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="560">
          <TextBlock Text="Open this tool in your browser" Foreground="#17354B" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"/>
          <TextBlock x:Name="fallback_text" TextWrapping="Wrap" TextAlignment="Center" Foreground="#38596F" Margin="0,18,0,18"/>
          <Button x:Name="fallback_button" Content="Open selected site" Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Center"/>
          <TextBlock Text="You can continue working in Revit while this window stays open." TextWrapping="Wrap" TextAlignment="Center" Foreground="#38596F" FontSize="12" Margin="0,16,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="4" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="status_text" Text="Opening Image to Text..." Foreground="{DynamicResource AccentBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
      <TextBlock Grid.Column="1" Text="Web tools  |  Internet required" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="12,0,0,0"/>
    </Grid>
    <Border Grid.Row="5" Background="#082335" BorderBrush="#176282" BorderThickness="1" CornerRadius="4" Padding="9,7" Margin="0,7,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="humor_text" Text="Revit knows what you want. It just refuses to cooperate." Foreground="#88BED5" FontSize="11" TextWrapping="Wrap" Margin="0,0,12,0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox x:Name="humor_toggle" Content="BIM Humor On" IsChecked="True" Foreground="#00C6E8" FontSize="11" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
          <Button x:Name="humor_next_button" Content="Next Joke" Padding="8,3" MinHeight="26" FontSize="11" ToolTip="Show another BIM joke"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="6" Margin="1,9,1,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Created by Nataraj Devaraj." Foreground="#88ADC2" FontSize="11"/>
        <TextBlock Text="Revit 2022–2027 | IronPython 2.7" Foreground="#88ADC2" FontSize="10" Margin="0,3,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="#082335" BorderBrush="#176282" BorderThickness="1" CornerRadius="6" Padding="4">
          <Button x:Name="github_button" Content="★ Star NdevTools on GitHub" MinHeight="29" Padding="8,4" FontSize="11" FontWeight="SemiBold" Foreground="#00C6E8" BorderBrush="#176282" ToolTip="Visit NdevTools on GitHub to star the repository"/>
        </Border>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
