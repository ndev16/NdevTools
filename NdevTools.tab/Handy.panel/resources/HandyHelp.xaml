<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NdevTools | Help" Width="650" Height="640" MinWidth="540" MinHeight="440"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image x:Name="brand_logo" Width="48" Height="48" Stretch="Uniform"/>
      <Border Width="1" Height="44" Background="#176282" HorizontalAlignment="Right" Margin="0,0,1,0"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
        <TextBlock x:Name="help_title" Text="Help" FontSize="24" FontWeight="Bold"/>
        <TextBlock Text="INSTRUCTIONS &amp; SUPPORT" Foreground="#00C6E8" FontSize="11" Margin="0,5,0,0"/>
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,14">
      <TextBlock x:Name="help_body" TextWrapping="Wrap" LineHeight="22" Margin="0,0,10,0"/>
    </ScrollViewer>
    <StackPanel Grid.Row="2">
      <Border Background="#082335" BorderBrush="#21516A" BorderThickness="1" CornerRadius="5" Padding="11,9" Margin="0,0,0,10">
        <TextBlock x:Name="support_message" Text="Enjoying NdevTools? Please consider giving the NdevTools project a star on GitHub! Have suggestions, feedback, or feature requests? Feel free to share them on GitHub or connect on LinkedIn."
                   TextWrapping="Wrap" Foreground="#E9F6FF" FontSize="12" LineHeight="20"/>
      </Border>
      <Button x:Name="help_github_button" Content="GitHub  |  github.com/ndev16/NdevTools" Margin="0,0,0,7"/>
      <Button x:Name="help_linkedin_button" Content="LinkedIn  |  linkedin.com/in/nataraj016" Margin="0,0,0,10"/>
    </StackPanel>
    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="Created by Nataraj Devaraj." Foreground="#88ADC2" FontSize="11"/><TextBlock Text="Revit 2022–2027 | IronPython 2.7" Foreground="#88ADC2" FontSize="10" Margin="0,3,0,0"/></StackPanel>
      <Button Grid.Column="1" x:Name="close_button" Content="Close" MinWidth="80"/>
    </Grid>
    <TextBlock Grid.Row="4" x:Name="status_text" Text="" TextWrapping="Wrap" FontSize="11" Foreground="#88ADC2" Margin="0,5,0,0"/>
  </Grid>
</Window>
